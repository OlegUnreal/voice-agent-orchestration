# cp compose.env.example .env
# docker compose up --build

# Leave empty for the bundled demo tape.
HELIX_MCP_URL=
HELIX_MCP_TOKEN=
HELIX_MCP_PROTOCOL=2025-06-18
HELIX_MCP_TIMEOUT=8

# false = refuse fake prices when MCP is down (use this on Tailscale)
HELIX_ALLOW_SIMULATOR=true

# Optional Grok narration + TTS in the voice UI
XAI_API_KEY=
