# Leave empty for the bundled demo tape.
HELIX_MCP_URL=
HELIX_MCP_TOKEN=
HELIX_MCP_PROTOCOL=2025-06-18
HELIX_MCP_TIMEOUT=8
HELIX_ALLOW_SIMULATOR=true

# hash (CI default) or st (+ pip install helix-engines[nlp])
HELIX_EMBEDDINGS=hash
HELIX_CROSS_ENCODER=

# Optional Grok / vLLM narrator
XAI_API_KEY=
HELIX_VLLM_URL=
HELIX_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HELIX_VLLM_TOKEN=

# Optional pgvector memory (compose --profile pg)
# DATABASE_URL=postgresql://helix:helix@db:5432/helix
DATABASE_URL=
